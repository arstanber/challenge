    "A dot for every day this month -- filled when you hit the goal.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dot for every day this month -- filled when you hit the goal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точка на каждый день месяца -- закрашена, когда цель выполнена."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Punkt für jeden Tag im Monat -- gefüllt, wenn du dein Ziel erreichst."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ай ішіндегі әр күнге бір нүкте -- мақсатқа жеткенде боялады."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point par jour du mois -- rempli quand tu atteins l'objectif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقطة لكل يوم في الشهر -- تُملأ عند تحقيق الهدف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto por cada día de este mes, que se rellena cuando alcanzas la meta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の毎日のドット -- 目標を達成すると塗りつぶされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 달에는 매일 점을 찍습니다. 목표를 달성하면 채워집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ponto para cada dia deste mês -- preenchido quando você atinge a meta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个月的每一天都有一个点----当你达到目标时就填满。"
          }
        }
      }
    },
