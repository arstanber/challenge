    "Уведомления выключены. Разрешите их в настройках, чтобы напоминание сработало.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطّلة. فعّلها من الإعدادات حتى تعمل التذكيرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind aus. Erlaube sie in den Einstellungen, damit Erinnerungen funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Allow them in Settings for reminders to work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Autorise-les dans les réglages pour que les rappels fonctionnent."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хабарландырулар өшірулі. Еске салулар жұмыс істеуі үшін параметрлерден рұқсат бер."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Permítalos en Configuración para que funcionen los recordatorios."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はオフになっています。リマインダーが機能するように設定で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있습니다. 알림이 작동하려면 설정에서 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Permita-os nas configurações para que os lembretes funcionem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。在“设置”中允许它们以便提醒发挥作用。"
          }
        }
      }
    },
