    "За каждого друга: 3 дня PRO или 1 заморозка серии. 10 друзей -- целый месяц PRO.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عن كل صديق: 3 أيام من PRO أو تجميد واحد للسلسلة. 10 أصدقاء -- شهر كامل من PRO."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jeden Freund: 3 Tage PRO oder 1 Serien-Freeze. 10 Freunde -- ein ganzer Monat PRO."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For every friend: 3 days of PRO or 1 streak freeze. 10 friends -- a whole month of PRO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour chaque ami : 3 jours de PRO ou 1 freeze de série. 10 amis -- un mois entier de PRO."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр дос үшін: 3 күн PRO немесе 1 серия тоңазытқышы. 10 дос -- толық бір ай PRO."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por cada amigo: 3 días de PRO o 1 racha congelada. 10 amigos: un mes entero de PRO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての友人に: 3 日間の PRO または 1 回の連続凍結。友達 10 人 -- 丸々 1 か月の PRO。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 친구에게: 3일 PRO 또는 1회 연속 동결. 10명의 친구 - 한 달 내내 PRO를 이용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cada amigo: 3 dias de PRO ou 1 sequência de congelamento. 10 amigos -- um mês inteiro de PRO."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于每位朋友：3 天 PRO 或 1 次连续冻结。 10 个朋友----整整一个月的 PRO。"
          }
        }
      }
    },
    "За последние 30 дней": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلال آخر 30 يومًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den letzten 30 Tagen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the last 30 days"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au cours des 30 derniers jours"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Соңғы 30 күнде"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante los últimos 30 días"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 30 日間"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 30일 동안"
          }
        },
        "pt": {
