    "Мы напомним только, если привычка ещё не выполнена.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنذكّرك فقط إذا لم تكتمل العادة بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erinnern dich nur, wenn die Gewohnheit noch nicht erledigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll only remind you if the habit isn't done yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On te le rappellera seulement si l'habitude n'est pas encore terminée."
