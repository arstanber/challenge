        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$lld jours de suite sur reInspire ! Rejoins-moi : %2$@ #reInspire #habitudes"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 reInspire-те қатарынан %1$lld күн! Қосыл: %2$@ #reInspire #әдеттер"
