    "Осталось дней: %lld. Побеждает тот, кто выполнил больше дел.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld يومًا متبقيًا. يفوز من ينجز أكثر عدد من المهام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage übrig. Wer mehr Aufgaben erledigt, gewinnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days left. Whoever completes more tasks wins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jours restants. Celui qui termine le plus de tâches gagne."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld күн қалды. Кім көп іс орындаса, сол жеңеді."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan %lld días. Quien complete más tareas gana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り %lld 日です。より多くのタスクを完了した人が勝ちです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 남았습니다. 더 많은 작업을 완료하는 사람이 승리합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
