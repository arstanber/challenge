    "We'll open Telegram with a one-time code pre-filled. Send it to the bot to link this account -- the code expires in 10 minutes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنفتح Telegram مع رمز لمرة واحدة مُعبأ مسبقًا. أرسله إلى البوت لربط هذا الحساب -- ينتهي صلاحية الرمز خلال 10 دقائق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir öffnen Telegram mit einem vorausgefüllten Einmalcode. Sende ihn an den Bot, um dieses Konto zu verknüpfen -- der Code läuft in 10 Minuten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll open Telegram with a one-time code pre-filled. Send it to the bot to link this account -- the code expires in 10 minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On va ouvrir Telegram avec un code à usage unique pré-rempli. Envoie-le au bot pour lier ce compte -- le code expire dans 10 minutes."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram-ды алдын ала толтырылған бір реттік кодпен ашамыз. Осы аккаунтты байланыстыру үшін оны ботқа жібер -- код 10 минуттан кейін жарамсыз болады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроем Telegram с уже вставленным одноразовым кодом. Отправь его боту, чтобы привязать аккаунт -- код действует 10 минут."
          }
        }
      }
    },
