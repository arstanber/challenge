    "You can relink anytime from this screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إعادة الربط في أي وقت من هذه الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich jederzeit über diesen Bildschirm neu verknüpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can relink anytime from this screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux relier ton compte à tout moment depuis cet écran."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы экраннан кез келген уақытта қайта байланыстыра аласың."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязать заново можно в любой момент с этого экрана."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede volver a vincularse en cualquier momento desde esta pantalla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面からいつでも再リンクできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에서 언제든지 다시 연결할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode vincular novamente a qualquer momento nesta tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以随时从此屏幕重新链接。"
          }
        }
      }
    },
    "You can't \nforget about it. Turn on \nthe Push-notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك \nأن تنساها. فعّل \nالإشعارات الفورية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst es \nnicht vergessen. Schalte \ndie Push-Benachrichtigungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't \nforget about it. Turn on \nthe Push-notifications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne peux pas \nl'oublier. Active \nles notifications push."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сен ол туралы \nұмыта алмайсың. Push-хабарландыруларды \nқос."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Об этом не получится \nзабыть. Включи \nпуш-уведомления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no puedes \nolvídalo. encender \nlas notificaciones push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "できません \nそれは忘れてください。オンにする \nプッシュ通知。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 할 수 없습니다 \n잊어버리세요. 켜다 \n푸시 알림."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode \nesqueça isso. Ligar \nas notificações push."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不能 \n忘记它吧。打开 \n推送通知。"
          }
        }
      }
    },
    "You can't talk yourself out of doing this. Send photo to prove.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكنك التهرّب من هذا. أرسل صورة كدليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da kommst du nicht raus. Schick ein Foto als Beweis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't talk yourself out of doing this. Send photo to prove."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de te trouver une excuse. Envoie une photo pour le prouver."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұдан сөзбен құтыла алмайсың. Дәлелдеу үшін фото жібер."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отговорить себя не выйдет. Отправь фото как доказательство."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes convencerte de no hacer esto. Enviar foto para probar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをやめることはできません。証明する写真を送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 일을 하지 말라고 스스로 말할 수는 없습니다. 증명할 사진을 보내세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode se convencer de não fazer isso. Envie foto para comprovar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你无法说服自己不这样做。发照片来证明。"
          }
        }
      }
    },
