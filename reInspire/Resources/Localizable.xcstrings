    "Disconnecting stops the bot from creating tasks, accepting photos, or sending you notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع قطع الاتصال الروبوت من إنشاء مهام أو قبول صور أو إرسال إشعارات إليك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Trennen kann der Bot keine Aufgaben mehr erstellen, keine Fotos annehmen und dir keine Benachrichtigungen senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting stops the bot from creating tasks, accepting photos, or sending you notifications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion empêche le bot de créer des tâches, d'accepter des photos ou de t'envoyer des notifications."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ажыратқанда бот тапсырма жасай алмайды, фото қабылдамайды және хабарландыру жібермейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После отключения бот больше не сможет создавать задачи, принимать фото и присылать уведомления."
          }
        }
      }
    },
