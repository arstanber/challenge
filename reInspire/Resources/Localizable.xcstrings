    "Подключённые данные помогают честно подтвердить достижение цели.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد بيانات الخدمات المتصلة في التأكد من تحقيق هدفك بصدق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten aus verknüpften Diensten helfen dabei, ehrlich zu bestätigen, dass du dein Ziel erreicht hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data from connected services helps confirm that you've truly reached your goal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des services connectés permettent de confirmer que tu as réellement atteint ton objectif."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосылған сервистердің деректері мақсатыңа шынымен жеткеніңді растауға көмектеседі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключённые данные помогают честно подтвердить достижение цели."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de los servicios conectados ayudan a confirmar que realmente ha alcanzado su objetivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続されたサービスからのデータは、本当に目標を達成したことを確認するのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 서비스의 데이터는 귀하가 실제로 목표를 달성했는지 확인하는 데 도움이 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados dos serviços conectados ajudam a confirmar que você realmente atingiu seu objetivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自互联服务的数据有助于确认您是否真正实现了目标。"
          }
        }
      }
    },
    "Поднеси телефоны": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب الهاتفين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring die Handys zusammen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the phones together"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche les téléphones"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефондарды жақындат"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reúne los teléfonos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話機をひとつにまとめる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화기를 하나로 모으세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte os telefones"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机放在一起"
          }
        }
      }
    },
    "Поднесите телефон к телефону ребёнка и потрясите оба.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب هاتفك من هاتف طفلك وهزّا الهاتفين معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring dein Handy nah an das deines Kindes und schüttelt beide."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your phone close to your child's phone and shake both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche ton téléphone de celui de ton enfant et secouez les deux."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефоныңды бала телефонына жақындатып, екеуін де шайқа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerque su teléfono al de su hijo y agite ambos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話をお子様の携帯電話に近づけて、両方を振ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자녀의 휴대폰에 휴대폰을 가까이 가져다 대고 흔들어 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime o telefone do telefone do seu filho e agite ambos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您的手机靠近孩子的手机并摇动两者。"
          }
        }
      }
    },
    "Поднесите телефон к телефону родителя и потрясите оба.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب هاتفك من هاتف والدك أو والدتك وهزّا الهاتفين معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring dein Handy nah an das deines Elternteils und schüttelt beide."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your phone close to your parent's phone and shake both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche ton téléphone de celui de ton parent et secouez les deux."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефоныңды ата-анаң телефонына жақындатып, екеуін де шайқа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca tu teléfono al de tus padres y agita ambos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話を親の携帯電話に近づけて、両方を振ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부모님의 휴대폰에 휴대폰을 가까이 가져가서 둘 다 흔들어 보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime seu telefone do telefone de seus pais e agite ambos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您的手机靠近父母的手机并摇动两者。"
          }
        }
      }
    },
    "Поднесите телефоны ближе и потрясите оба ещё раз.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب الهاتفين أكثر وهزّاهما مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring die Handys näher zusammen und schüttelt beide erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the phones closer and shake both again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche encore les téléphones et secouez-les à nouveau."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефондарды жақындатып, екеуін де қайта шайқа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca los teléfonos y vuelve a agitar ambos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話を近づけて、もう一度両方を振ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화기를 더 가까이 가져오고 둘 다 다시 흔듭니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproxime os telefones e agite ambos novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机靠近并再次摇晃。"
          }
        }
      }
    },
