    "Register for events, subscribe\nto calendars and manage\nevents you're going to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل في الفعاليات، واشترك\nفي التقويمات وأدر\nالفعاليات التي ستحضرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich für Events an, abonniere\nKalender und verwalte\nEvents, zu denen du gehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register for events, subscribe\nto calendars and manage\nevents you're going to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscris-toi à des événements, abonne-toi\nà des calendriers et gère\nles événements auxquels tu participes."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Іс-шараларға тіркел, күнтізбелерге\nжазыл және баратын\nіс-шараларыңды басқар."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрируйся на события, подписывайся\nна календари и управляй\nсобытиями, куда идёшь."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regístrese para eventos, suscríbase\na calendarios y gestionar\neventos a los que vas a ir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントに登録、購読する\nカレンダーと管理\nあなたが行く予定のイベント。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트 등록, 구독\n캘린더 및 관리\n당신이 할 이벤트."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre-se em eventos, inscreva-se\npara calendários e gerenciar\neventos que você irá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册活动、订阅\n日历和管理\n你要去参加的活动。"
          }
        }
      }
    },
