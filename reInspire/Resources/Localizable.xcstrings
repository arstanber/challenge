        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشارك الرمز مع طفلك إلا إذا كنت موافقًا على مغادرته العائلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile den Code nur mit deinem Kind, wenn du damit einverstanden bist, dass es die Familie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only share the code with your kid if you're okay letting them leave the family."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne donne ce code à ton enfant que si tu es d'accord pour le laisser quitter la famille."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодты балаңа тек оны отбасынан жіберуге келіссең ғана айт."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo comparta el código con su hijo si está de acuerdo en dejar que abandone la familia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族から離れても大丈夫な場合にのみ、コードをお子様と共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자녀가 가족을 떠나도록 해도 괜찮을 경우에만 자녀에게 코드를 공유하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe o código apenas com seu filho se você concordar em deixá-lo sair da família."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当您同意让您的孩子离开家庭时才与他们分享代码。"
          }
        }
      }
    },
