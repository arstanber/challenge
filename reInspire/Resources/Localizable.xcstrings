      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Fitness"
          }
        }
      }
    },
    "Шаги" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steps"
          }
        }
      }
    },
    "Активная энергия (калории)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active energy (calories)"
          }
        }
      }
    },
    "Минуты тренировок" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercise minutes"
          }
        }
      }
    },
    "Дистанция ходьбы и бега" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walking and running distance"
          }
        }
      }
    },
    "reInspire читает указанные ниже данные из приложения «Здоровье» (Apple Health через HealthKit), чтобы автоматически засчитывать выполнение целей -- например, шаги или тренировки. Подключение не обязательно: цели всегда можно подтвердить фото." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reInspire reads the data below from the Health app (Apple Health via HealthKit) to automatically count your goals -- for example, steps or workouts. Connecting is optional: you can always confirm goals with a photo."
          }
        }
      }
    },
    "Что reInspire читает из Здоровья" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What reInspire reads from Health"
          }
        }
      }
    },
    "reInspire не записывает никакие данные в Здоровье -- доступ только на чтение." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "reInspire does not write any data to Health -- read-only access."
          }
        }
      }
    },
    "Подключить Здоровье" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect Health"
          }
        }
      }
    },
    "Здоровье недоступно на этом устройстве." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health is not available on this device."
          }
        }
      }
    },
