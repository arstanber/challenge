    "🏆 Победа! Соперник повержен.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 فوز! تم التغلب على الخصم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 Sieg! Gegner besiegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 Victory! Opponent defeated."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 Victoire ! L'adversaire est vaincu."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 Жеңіс! Қарсылас жеңілді."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 ¡Victoria! Oponente derrotado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆勝利!相手が負けた。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 승리! 상대가 패배했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆 Vitória! Oponente derrotado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🏆胜利！对手被击败。"
          }
        }
      }
    },
