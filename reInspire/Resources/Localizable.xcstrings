    "Подключённые данные помогают честно подтвердить достижение цели.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد بيانات الخدمات المتصلة في التأكد من تحقيق هدفك بصدق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten aus verknüpften Diensten helfen dabei, ehrlich zu bestätigen, dass du dein Ziel erreicht hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data from connected services helps confirm that you've truly reached your goal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des services connectés permettent de confirmer que tu as réellement atteint ton objectif."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосылған сервистердің деректері мақсатыңа шынымен жеткеніңді растауға көмектеседі."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключённые данные помогают честно подтвердить достижение цели."
          }
        }
      }
    },
    "Поднеси телефоны": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب الهاتفين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring die Handys zusammen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the phones together"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche les téléphones"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефондарды жақындат"
          }
        }
      }
    },
    "Поднесите телефон к телефону ребёнка и потрясите оба.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب هاتفك من هاتف طفلك وهزّا الهاتفين معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring dein Handy nah an das deines Kindes und schüttelt beide."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your phone close to your child's phone and shake both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche ton téléphone de celui de ton enfant et secouez les deux."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефоныңды бала телефонына жақындатып, екеуін де шайқа."
          }
        }
      }
    },
    "Поднесите телефон к телефону родителя и потрясите оба.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب هاتفك من هاتف والدك أو والدتك وهزّا الهاتفين معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring dein Handy nah an das deines Elternteils und schüttelt beide."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your phone close to your parent's phone and shake both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche ton téléphone de celui de ton parent et secouez les deux."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефоныңды ата-анаң телефонына жақындатып, екеуін де шайқа."
          }
        }
      }
    },
    "Поднесите телефоны ближе и потрясите оба ещё раз.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب الهاتفين أكثر وهزّاهما مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring die Handys näher zusammen und schüttelt beide erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the phones closer and shake both again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapproche encore les téléphones et secouez-les à nouveau."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефондарды жақындатып, екеуін де қайта шайқа."
          }
        }
      }
    },
