    "Не для кого-то. Для лучшей версии себя.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس من أجل أحد آخر. من أجل أفضل نسخة منك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht für jemand anderen. Für die beste Version von dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not for anyone else. For the best version of you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas pour quelqu'un d'autre. Pour la meilleure version de toi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біреу үшін емес. Өзіңнің ең үздік нұсқаң үшін."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No para nadie más. Para la mejor versión de ti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の誰のためでもない。あなたの最高のバージョンのために。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람을 위한 것이 아닙니다. 당신의 최고의 버전을 위해."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não para mais ninguém. Para a melhor versão de você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不为其他人。为您呈现最好的版本。"
          }
        }
      }
    },
