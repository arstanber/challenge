    "Ты выбираешь, кем становишься. Сделай задание.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت من يختار من تصبح. أنجز المهمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du entscheidest, wer du wirst. Mach die Aufgabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You choose who you become. Do the task."
          }
        },
