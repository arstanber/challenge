    "Живая активность": {
      "comment": "Title of a settings row that toggles the live activity feature.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النشاط المباشر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivität"
          }
        },
