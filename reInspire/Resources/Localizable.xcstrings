    },
    "Вызываю тебя на дуэль в reInspire ⚔️ Кто выполнит больше дел, тот и победил. Код: %@. Скачай: https://thechallenges.app": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتحداك في مباراة على reInspire ⚔️ من يُنهي أكثر مهام يفوز. الرمز: %@. نزّل التطبيق: https://thechallenges.app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fordere dich zum Duell in reInspire heraus ⚔️ Wer mehr Aufgaben erledigt, gewinnt. Code: %@. Lade es herunter: https://thechallenges.app"
          }
        },
        "en": {
          "stringUnit": {
