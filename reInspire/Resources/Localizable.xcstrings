    "🔥 %lld дней подряд в reInspire! Присоединяйся: %@ #reInspire #привычки": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$lld يومًا متتاليًا في reInspire! انضم إلي: %2$@ #reInspire #عادات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$lld Tage am Stück in reInspire! Mach mit: %2$@ #reInspire #Gewohnheiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "🔥 %1$lld дней подряд в reInspire! Присоединяйся: %2$@ #reInspire #привычки"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$lld jours de suite sur reInspire ! Rejoins-moi : %2$@ #reInspire #habitudes"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 reInspire-те қатарынан %1$lld күн! Қосыл: %2$@ #reInspire #әдеттер"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 ¡%1$lld días seguidos en reInspire! Únete: %2$@ #reInspire #habits"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$lld 日連続で reInspire を利用できます!参加: %2$@ #reInspire #習慣"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 reInspire에서 %1$lld일 연속! 참여: %2$@ #reInspire #habits"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$lld dias seguidos no reInspire! Participe: %2$@ #reInspirar #hábitos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 连续几天在 reInspire 中 %1$lld！加入：%2$@ #reInspire #habits"
          }
        }
      }
    },
