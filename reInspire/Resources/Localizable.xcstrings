    "Придумай почту и пароль -- ими ты будешь входить дальше. Родитель сможет их изменить.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بريدًا إلكترونيًا وكلمة مرور -- ستستخدمهما لتسجيل الدخول لاحقًا. يمكن لأحد الوالدين تغييرهما بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine E-Mail und ein Passwort -- damit meldest du dich künftig an. Ein Elternteil kann sie später ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
