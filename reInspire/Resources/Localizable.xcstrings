    "Один создаёт дуэль, второй присоединяется. Потом потрясите оба телефона.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم شخص بإنشاء التحدي، وينضم الآخر إليه. ثم هزّا كلا الهاتفين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Person erstellt das Duell, die andere tritt bei. Dann schüttelt beide Handys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One person creates the duel, the other joins. Then shake both phones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne crée le duel, l'autre rejoint. Ensuite, secouez les deux téléphones."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біреуі дуэль жасайды, екіншісі қосылады. Сосын екі телефонды шайқаңыз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona crea el duelo, la otra se une. Luego agite ambos teléfonos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 人が決闘を開始し、もう 1 人が参加します。次に、両方の携帯電話を振ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 사람이 결투를 만들고 다른 사람이 결투에 참여합니다. 그런 다음 두 전화기를 모두 흔들어주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa cria o duelo, a outra entra. Em seguida, agite os dois telefones."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个人发起决斗，另一个人加入。然后摇动两部手机。"
          }
        }
      }
    },
    "Один шаг сегодня -- большой результат завтра.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوة واحدة اليوم -- نتيجة كبيرة غدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt heute ist ein großes Ergebnis morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step today is a big result tomorrow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pas aujourd'hui, un grand résultat demain."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгінгі бір қадам -- ертеңгі үлкен нәтиже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso hoy es un gran resultado mañana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の一歩が明日の大きな結果につながります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 한 걸음이 내일의 큰 결과가 됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um passo hoje é um grande resultado amanhã."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的一步就是明天的重大成果。"
          }
        }
      }
    },
    "Одно маленькое действие меняет всё.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمل صغير واحد يغيّر كل شيء."
          }
        },
