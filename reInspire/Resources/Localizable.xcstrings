          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Достың кодын енгізіп, 3 күн PRO ал."
          }
        }
      }
    },
    "Введи код, который прислал друг": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز الذي أرسله صديقك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Code ein, den dein Freund geschickt hat"
