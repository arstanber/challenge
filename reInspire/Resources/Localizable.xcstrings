    "Пока нет детей. Создай аккаунт или пригласи по коду.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد أطفال حتى الآن. أنشئ حسابًا أو وجّه دعوة برمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Kinder. Erstelle ein Konto oder lade per Code ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No kids yet. Create an account or invite with a code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'enfants. Crée un compte ou invite avec un code."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге бала жоқ. Аккаунт жаса немесе кодпен шақыр."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay niños. Crea una cuenta o invita con un código."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ子供はいません。アカウントを作成するか、コードを使用して招待します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아이가 없습니다. 계정을 만들거나 코드로 초대하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há filhos. Crie uma conta ou convide com um código."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有孩子。使用代码创建帐户或邀请。"
          }
        }
      }
    },
    "Пока нет заданий. Дай задание ребёнку (свайп влево по нему) или сразу всем.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مهام حتى الآن. كلّف أحد الأطفال بمهمة (اسحب لليسار عليه) أو كلّف الجميع دفعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Aufgaben. Weise einem Kind eine zu (nach links wischen) oder allen auf einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tasks yet. Assign one to a kid (swipe left on them) or to everyone at once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de tâches. Assigne-en une à un enfant (glisse vers la gauche dessus) ou à tous en même temps."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге тапсырма жоқ. Балаға тапсырма бер (оны солға сырғыт) немесе бірден барлығына."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay tareas. Asigne uno a un niño (deslícelo hacia la izquierda) o a todos a la vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだタスクはありません。 1 つを子供 (左にスワイプ) に割り当てるか、全員に一度に割り当てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 작업이 없습니다. 어린이에게 하나를 할당하거나(왼쪽으로 스와이프) 모든 사람에게 동시에 할당합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa ainda. Atribua um a uma criança (deslize para a esquerda) ou a todos de uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有任务。将一个分配给一个孩子（向左滑动）或一次分配给每个人。"
          }
        }
      }
    },
