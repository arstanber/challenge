    "Убери лишнее -- смахни задачу или нажми ×": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف ما لا تحتاجه -- اسحب المهمة أو اضغط ×"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne Überflüssiges -- wische eine Aufgabe oder tippe auf ×"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove what you don't need -- swipe a task or tap ×"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire le superflu -- balaie une tâche ou appuie sur ×"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Артықты алып таста -- тапсырманы сырғыт немесе × бас"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina lo que no necesitas: desliza una tarea o toca ×"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不要なものを削除します -- タスクをスワイプするか、「×」をタップします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요하지 않은 것을 제거하세요. 작업을 스와이프하거나 ×를 탭하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova o que você não precisa: deslize uma tarefa ou toque em ×"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除不需要的内容 - 滑动任务或点击 ×"
          }
        }
      }
    },
