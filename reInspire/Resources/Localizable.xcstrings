    "Опиши цель, а reInspire превратит её в понятный план действий.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِف هدفك، وسيحوّله reInspire إلى خطة عمل واضحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe dein Ziel und reInspire erstellt daraus einen klaren Aktionsplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your goal, and reInspire will turn it into a clear action plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris ton objectif et reInspire le transformera en plan d’action clair."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мақсатыңды сипатта, ал reInspire оны нақты әрекет жоспарына айналдырады."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опиши цель, а reInspire превратит её в понятный план действий."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe tu objetivo y reInspire lo convertirá en un plan de acción claro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標を説明すると、reInspire がそれを明確な行動計画に変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 설명하면 reInspire가 이를 명확한 실행 계획으로 바꿔줄 것입니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva seu objetivo e o reInspire o transformará em um plano de ação claro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述您的目标，reInspire 会将其转化为明确的行动计划。"
          }
        }
      }
    },
    "Оправдание принято": {
      "localizations": {
