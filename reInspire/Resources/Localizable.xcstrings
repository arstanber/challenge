    "Подписка продлевается автоматически. Отменить можно в любой момент в App Store.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تجديد الاشتراك تلقائيًا. يمكنك إلغاءه في أي وقت من App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abonnement verlängert sich automatisch. Jederzeit im App Store kündbar."
          }
        },
        "en": {
          "stringUnit": {
