    "Каждый понедельник топ-3 получают заморозки серии: 3 / 2 / 1 🧊": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل يوم اثنين يحصل أفضل 3 على تجميدات للتتابع: 3 / 2 / 1 🧊"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Montag erhalten die Top 3 Serien-Freezes: 3 / 2 / 1 🧊"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Monday the top 3 get streak freezes: 3 / 2 / 1 🧊"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque lundi, le top 3 reçoit des gels de série : 3 / 2 / 1 🧊"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр дүйсенбіде үздік 3-ке серия тоңазытқыштары беріледі: 3 / 2 / 1 🧊"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los lunes la racha de los 3 primeros se congela: 3/2/1 🧊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週月曜日、トップ 3 の連続獲得が凍結されます: 3 / 2 / 1 🧊"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매주 월요일 상위 3위 연속 획득 동결: 3 / 2 / 1 🧊"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda segunda-feira, os 3 primeiros ficam congelados: 3/2/1 🧊"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个星期一前 3 名连续冻结：3 / 2 / 1 🧊"
          }
        }
      }
    },
    "Каждый успешный день без нежелательного действия продолжает серию.": {
      "comment": "A hint for the completion mode of the habit.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día exitoso sin una acción no deseada continúa la racha."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "望ましくないアクションを起こさずに成功した毎日が連続記録を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원치 않는 행동 없이 성공적인 하루하루가 연속으로 이어집니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia de sucesso sem uma ação indesejada dá continuidade à seqüência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一天没有发生不必要的行动，成功的一天都会延续下去。"
          }
        }
      }
    },
