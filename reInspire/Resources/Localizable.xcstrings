    "«%@»: цель пока не достигнута -- %@ по данным приложений. Завершите цель полностью или отключите строгий режим в настройках.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": لم يتم تحقيق الهدف بعد -- %@ وفقًا لبيانات التطبيقات. أكمل الهدف بالكامل أو عطّل الوضع الصارم في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": Ziel noch nicht erreicht -- %@ laut App-Daten. Schließe das Ziel vollständig ab oder schalte den strengen Modus in den Einstellungen aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\": goal not reached yet -- %@ according to app data. Finish the goal completely or turn off strict mode in settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" : objectif pas encore atteint -- %@ selon les données des applis. Termine complètement l'objectif ou désactive le mode strict dans les paramètres."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@»: мақсат әлі орындалмады -- қолданба деректері бойынша %@. Мақсатты толық аяқта немесе параметрлерден қатаң режимді өшір."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "new",
            "value": "«%1$@»: цель пока не достигнута -- %2$@ по данным приложений. Завершите цель полностью или отключите строгий режим в настройках."
          }
        }
      }
    },
