    "Поднесите телефон к телефону ребёнка и потрясите оба.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your phone close to your child's phone and shake both."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring dein Handy nah an das deines Kindes und schüttelt beide."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефоныңды бала телефонына жақындатып, екеуін де шайқа."
          }
        }
      }
    },
    "Поднесите телефон к телефону родителя и потрясите оба.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your phone close to your parent's phone and shake both."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring dein Handy nah an das deines Elternteils und schüttelt beide."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефоныңды ата-анаң телефонына жақындатып, екеуін де шайқа."
          }
        }
      }
    },
    "Поднесите телефоны ближе и потрясите оба ещё раз.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the phones closer and shake both again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring die Handys näher zusammen und schüttelt beide erneut."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефондарды жақындатып, екеуін де қайта шайқа."
