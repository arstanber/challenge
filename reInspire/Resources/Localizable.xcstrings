    "Нажмите \"Отправить как оправдание\", если была веская причина (травма, болезнь, форс-мажор)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على \"إرسال كإعذار\" إذا كان هناك سبب وجيه (إصابة، مرض، قوة قاهرة)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf \"Als entschuldigt einreichen\", falls es einen guten Grund gab (Verletzung, Krankheit, höhere Gewalt)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Submit as excused\" if there was a good reason (injury, illness, force majeure)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur \"Envoyer comme excuse\" s'il y avait une bonne raison (blessure, maladie, force majeure)"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дәлелді себеп болса (жарақат, ауру, форс-мажор) «Дәлел ретінде жіберу» дегенді бас"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque \"Enviar como excusado\" si hubo una buena razón (lesión, enfermedad, fuerza mayor)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正当な理由（怪我、病気、不可抗力）がある場合は、「免除として送信」をタップします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정당한 사유(부상, 질병, 불가항력)가 있는 경우 '변명으로 제출'을 탭하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em \"Enviar como justificado\" se houver um bom motivo (lesão, doença, força maior)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果有充分理由（受伤、疾病、不可抗力），请点击“有理由提交”"
          }
        }
      }
    },
