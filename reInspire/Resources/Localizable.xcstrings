          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "🔥 %1$lld Tage am Stück in reInspire! Mach mit: %2$@ #reInspire #Gewohnheiten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "🔥 %1$lld дней подряд в reInspire! Присоединяйся: %2$@ #reInspire #привычки"
