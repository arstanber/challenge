          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텔레그램을 연결 해제하시겠습니까?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectar o telegrama?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开电报连接？"
          }
        }
      }
    },
    "Disconnecting stops the bot from creating tasks, accepting photos, or sending you notifications.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع قطع الاتصال الروبوت من إنشاء مهام أو قبول صور أو إرسال إشعارات إليك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Trennen kann der Bot keine Aufgaben mehr erstellen, keine Fotos annehmen und dir keine Benachrichtigungen senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting stops the bot from creating tasks, accepting photos, or sending you notifications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion empêche le bot de créer des tâches, d'accepter des photos ou de t'envoyer des notifications."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ажыратқанда бот тапсырма жасай алмайды, фото қабылдамайды және хабарландыру жібермейді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После отключения бот больше не сможет создавать задачи, принимать фото и присылать уведомления."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La desconexión impide que el bot cree tareas, acepte fotos o le envíe notificaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切断すると、ボットによるタスクの作成、写真の受け入れ、通知の送信が停止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 끊으면 봇이 작업 생성, 사진 수락 또는 알림 보내기를 중지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A desconexão impede que o bot crie tarefas, aceite fotos ou envie notificações para você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接会阻止机器人创建任务、接受照片或向您发送通知。"
          }
        }
      }
    },
