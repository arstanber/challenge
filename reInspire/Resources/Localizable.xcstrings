    "Pick apps to shield while you focus on your activities.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر التطبيقات التي تريد حظرها بينما تركّز على أنشطتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Apps, die abgeschirmt werden, während du dich auf deine Aktivitäten konzentrierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick apps to shield while you focus on your activities."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les applis à bloquer pendant que tu te concentres sur tes activités."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әрекеттеріңе шоғырланған кезде қалқаланатын қолданбаларды таңда."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери приложения, которые скрыть, пока ты занят делами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige aplicaciones para protegerte mientras te concentras en tus actividades."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティビティに集中している間、保護するアプリを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활동에 집중하는 동안 보호할 앱을 선택하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha aplicativos para proteger enquanto você se concentra em suas atividades."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您专注于自己的活动时，选择要屏蔽的应用程序。"
          }
        }
      }
    },
