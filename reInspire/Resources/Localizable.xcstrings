    "Describe what the photo should show. Claude AI will verify each submission.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِف ما يجب أن تُظهره الصورة. سيتحقق Claude AI من كل إرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was das Foto zeigen soll. Claude AI prüft jede Einreichung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what the photo should show. Claude AI will verify each submission."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris ce que la photo doit montrer. Claude AI vérifiera chaque envoi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотода не көрінуі керегін сипатта. Claude AI әрбір жіберілімді тексереді."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опиши, что должно быть на фото. Claude AI проверит каждый отчёт."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe lo que debe mostrar la foto. Claude AI verificará cada envío."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真が何を示すべきかを説明します。 Claude AI は各提出物を検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 무엇을 보여주어야 하는지 설명하세요. Claude AI가 각 제출 내용을 확인합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o que a foto deve mostrar. Claude AI verificará cada envio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述照片应该显示什么。 Claude AI 将验证每份提交内容。"
          }
        }
      }
    },
