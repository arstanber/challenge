    "Все ваши привычки, отчёты и профиль будут удалены без возможности восстановления.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف جميع عاداتك وتقاريرك وملفك الشخصي بشكل نهائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Gewohnheiten, Berichte und dein Profil werden unwiderruflich gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your habits, reports, and profile will be permanently deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes tes habitudes, tes rapports et ton profil seront supprimés définitivement."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық әдеттерің, есептерің және профилің қалпына келтірілмейтіндей жойылады."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos sus hábitos, informes y perfil se eliminarán permanentemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの習慣、レポート、プロフィールはすべて完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 습관, 보고서, 프로필이 영구적으로 삭제됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus hábitos, relatórios e perfil serão excluídos permanentemente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的所有习惯、报告和个人资料都将被永久删除。"
          }
        }
      }
    },
    "Все доступные шаги на сегодня пройдены.": {
      "comment": "A description of the completion of a routine.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los pasos disponibles se han completado por hoy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日、利用可能なすべての手順が完了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 사용 가능한 모든 단계가 완료되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as etapas disponíveis foram concluídas hoje."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天所有可用的步骤均已完成。"
          }
        }
      }
    },
    "Все участники будут откреплены. Подписки это не затронет.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم فصل جميع الأعضاء. لن يؤثر ذلك على الاشتراكات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Mitglieder werden getrennt. Abonnements sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All members will be unlinked. Subscriptions won't be affected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les membres seront dissociés. Les abonnements ne seront pas affectés."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық қатысушылар ажыратылады. Жазылымдарға әсер етпейді."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los miembros serán desvinculados. Las suscripciones no se verán afectadas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのメンバーのリンクが解除されます。サブスクリプションには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 구성원의 연결이 해제됩니다. 구독에는 영향을 미치지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os membros serão desvinculados. As assinaturas não serão afetadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有成员都将被取消链接。订阅不会受到影响。"
          }
        }
      }
    },
