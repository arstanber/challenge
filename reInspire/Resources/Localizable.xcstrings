    "😤 Поражение. Реванш расставит всё по местам.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 خسارة. ستضع المباراة الفاصلة الأمور في نصابها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 Niederlage. Eine Revanche bringt alles ins Lot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 Defeat. A rematch will settle the score."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 Défaite. Une revanche remettra les choses à leur place."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 Жеңіліс. Реванш бәрін орнына қояды."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 Derrota. Una revancha ajustará cuentas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 敗北。再戦で決着がつきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 패배. 재대결을 통해 점수가 결정됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 Derrota. Uma revanche acertará as contas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "😤 失败。重赛将解决比分。"
          }
        }
