    "Объединяй привычки в последовательности и выполняй их без лишних пауз.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع العادات في تسلسلات وأنجزها من دون فواصل غير ضرورية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasse Gewohnheiten zu Abläufen zusammen und erledige sie ohne unnötige Pausen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group habits into sequences and complete them without unnecessary pauses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupe tes habitudes en séquences et enchaîne-les sans pauses inutiles."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттерді бірізді тізбектерге біріктіріп, артық үзіліссіз орында."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяй привычки в последовательности и выполняй их без лишних пауз."
          }
        }
      }
    },
