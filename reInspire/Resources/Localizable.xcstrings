    "Привычка засчитывается только при полном достижении цели (например, 10 000 из 10 000 шагов).": {
      "comment": "Tooltip for the \"Strict mode\" setting.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم احتساب العادة إلا عند تحقيق الهدف بالكامل (مثلًا، 10000 من 10000 خطوة)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gewohnheit zählt nur, wenn das Ziel vollständig erreicht ist (zum Beispiel 10.000 von 10.000 Schritten)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A habit counts only when the goal is fully reached (for example, 10,000 of 10,000 steps)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'habitude n'est validée que lorsque l'objectif est entièrement atteint (par exemple, 10 000 sur 10 000 pas)."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдет мақсат толық орындалғанда ғана есептеледі (мысалы, 10 000 қадамнан 10 000)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hábito cuenta sólo cuando se alcanza la meta por completo (por ejemplo, 10.000 de 10.000 pasos)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣は、目標が完全に達成された場合にのみカウントされます (たとえば、10,000 歩のうち 10,000 歩)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관은 목표가 완전히 달성된 경우에만 계산됩니다(예: 10,000걸음 중 10,000걸음)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um hábito conta apenas quando a meta é totalmente alcançada (por exemplo, 10.000 de 10.000 passos)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当完全达到目标（例如，10,000 步中的 10,000 步）时，习惯才算数。"
          }
        }
      }
    },
