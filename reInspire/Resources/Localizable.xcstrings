          "stringUnit": {
            "state": "translated",
            "value": "Wrong code or couldn't change the password. Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code incorrect ou échec de la modification du mot de passe. Réessaie."
