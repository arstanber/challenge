    "Не дай этому дню пройти впустую.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تدع هذا اليوم يضيع دون فائدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass diesen Tag nicht ungenutzt verstreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't let this day pass for nothing."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laisse pas cette journée passer pour rien."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл күнді бекер өткізбе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No dejes pasar este día en vano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日を無駄に過ぎさせないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 하루를 헛되이 보내지 마십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deixe esse dia passar em vão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要让这一天白白过去。"
          }
        }
      }
    },
