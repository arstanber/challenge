        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Саған 3 күн PRO есептелді. Досыңа да сыйлық келеді."
          }
        }
      }
    },
    "Тебя пригласили в семью по коду %@. Присоединиться сейчас?": {
      "localizations": {
        "ar": {
          "stringUnit": {
