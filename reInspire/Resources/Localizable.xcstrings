    "Register for events, subscribe\nto calendars and manage\nevents you're going to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل في الفعاليات، واشترك\nفي التقويمات وأدر\nالفعاليات التي ستحضرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich für Events an, abonniere\nKalender und verwalte\nEvents, zu denen du gehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register for events, subscribe\nto calendars and manage\nevents you're going to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inscris-toi à des événements, abonne-toi\nà des calendriers et gère\nles événements auxquels tu participes."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Іс-шараларға тіркел, күнтізбелерге\nжазыл және баратын\nіс-шараларыңды басқар."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регистрируйся на события, подписывайся\nна календари и управляй\nсобытиями, куда идёшь."
          }
        }
      }
    },
