    "Придумай почту и пароль -- ими ты будешь входить дальше. Родитель сможет их изменить.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بريدًا إلكترونيًا وكلمة مرور -- ستستخدمهما لتسجيل الدخول لاحقًا. يمكن لأحد الوالدين تغييرهما بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine E-Mail und ein Passwort -- damit meldest du dich künftig an. Ein Elternteil kann sie später ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick an email and password -- you'll use them to log in next time. A parent can change them later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un e-mail et un mot de passe -- tu les utiliseras pour te connecter la prochaine fois. Un parent pourra les modifier plus tard."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошта мен құпиясөз ойлап тап -- келесіде осымен кіресің. Ата-анаң оларды кейін өзгерте алады."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un correo electrónico y una contraseña; los usará para iniciar sesión la próxima vez. Un padre puede cambiarlos más tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電子メールとパスワードを選択します。次回ログインするときにそれらを使用します。保護者は後で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일과 비밀번호를 선택하세요. 다음에 로그인할 때 사용됩니다. 나중에 부모님이 변경할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um e-mail e uma senha -- você os usará para fazer login na próxima vez. Um pai pode alterá-los mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择电子邮件和密码 - 您下次将使用它们登录。家长可以稍后更改它们。"
          }
        }
      }
    },
