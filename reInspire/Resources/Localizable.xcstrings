    "Подписка продлевается автоматически. Отменить можно в любой момент в App Store.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تجديد الاشتراك تلقائيًا. يمكنك إلغاءه في أي وقت من App Store."
          }
        },
        "de": {
          "stringUnit": {
