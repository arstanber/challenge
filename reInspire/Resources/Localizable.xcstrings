    "Вызываю тебя на дуэль в reInspire ⚔️ Код: %@. Скачай: https://thechallenges.app": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أتحداك في مباراة على reInspire ⚔️ الرمز: %@. نزّل التطبيق: https://thechallenges.app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fordere dich zum Duell in reInspire heraus ⚔️ Code: %@. Lade es herunter: https://thechallenges.app"
          }
        },
        "en": {
