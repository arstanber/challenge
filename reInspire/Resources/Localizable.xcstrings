    "Один создаёт дуэль, второй присоединяется. Потом потрясите оба телефона.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم شخص بإنشاء التحدي، وينضم الآخر إليه. ثم هزّا كلا الهاتفين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Person erstellt das Duell, die andere tritt bei. Dann schüttelt beide Handys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One person creates the duel, the other joins. Then shake both phones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne crée le duel, l'autre rejoint. Ensuite, secouez les deux téléphones."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біреуі дуэль жасайды, екіншісі қосылады. Сосын екі телефонды шайқаңыз."
          }
        }
      }
    },
    "Один шаг сегодня -- большой результат завтра.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوة واحدة اليوم -- نتيجة كبيرة غدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt heute ist ein großes Ergebnis morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step today is a big result tomorrow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pas aujourd'hui, un grand résultat demain."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүгінгі бір қадам -- ертеңгі үлкен нәтиже."
          }
        }
      }
    },
    "Одно маленькое действие меняет всё.": {
      "localizations": {
