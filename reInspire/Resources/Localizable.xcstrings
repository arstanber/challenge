          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد وصول إلى الموقع. اسمح بالوصول من الإعدادات حتى يعمل التذكير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf den Standort. Erlaube den Zugriff in den Einstellungen, damit die Erinnerung funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to location. Allow access in Settings so the reminder can work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'accès à la localisation. Autorise l'accès dans les réglages pour que le rappel fonctionne."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Геолокацияға рұқсат жоқ. Еске салу жұмыс істеуі үшін параметрлерден рұқсат бер."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a la ubicación. Permita el acceso en Configuración para que el recordatorio pueda funcionar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所へのアクセスはできません。リマインダーが機能できるように、設定でアクセスを許可します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치에 접근할 수 없습니다. 알림이 작동할 수 있도록 설정에서 액세스를 허용하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao local. Permita o acesso nas configurações para que o lembrete funcione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问位置。在“设置”中允许访问，以便提醒可以发挥作用。"
