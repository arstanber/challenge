    "Поделись кодом или ссылкой, либо потрясите два телефона рядом, чтобы добавить ребёнка.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك الرمز أو الرابط، أو هزّا هاتفين معًا لإضافة طفل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile den Code oder Link oder schüttelt zwei Handys zusammen, um ein Kind hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the code or link, or shake two phones together to add a child."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage le code ou le lien, ou secouez deux téléphones l'un près de l'autre pour ajouter un enfant."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бала қосу үшін кодты не сілтемені бөліс, немесе екі телефонды бірге шайқа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparta el código o enlace, o agite dos teléfonos para agregar un niño."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードまたはリンクを共有するか、2 台の携帯電話を一緒に振って子供を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드나 링크를 공유하거나, 두 대의 휴대폰을 함께 흔들어 자녀를 추가하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe o código ou link ou agite dois telefones para adicionar uma criança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享代码或链接，或者同时摇动两部手机来添加孩子。"
          }
        }
      }
    },
