          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich fordere dich zum Duell in reInspire heraus ⚔️ Code: %@. Lade es herunter: https://thechallenges.app"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm challenging you to a duel in reInspire ⚔️ Code: %@. Download: https://thechallenges.app"
