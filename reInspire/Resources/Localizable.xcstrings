    "Сообщи код ребёнку, только если согласен отпустить его из семьи.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تشارك الرمز مع طفلك إلا إذا كنت موافقًا على مغادرته العائلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile den Code nur mit deinem Kind, wenn du damit einverstanden bist, dass es die Familie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only share the code with your kid if you're okay letting them leave the family."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne donne ce code à ton enfant que si tu es d'accord pour le laisser quitter la famille."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодты балаңа тек оны отбасынан жіберуге келіссең ғана айт."
          }
        }
      }
    },
    "Соперник": {
      "localizations": {
