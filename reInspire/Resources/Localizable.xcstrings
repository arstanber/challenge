    "Введи свой ник на Chess.com. Мы будем считать сыгранные за день партии через публичный API -- авторизация не нужна.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم المستخدم الخاص بك على Chess.com. سنحسب المباريات التي تُلعب كل يوم عبر الواجهة البرمجية العامة -- لا حاجة لتسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinen Chess.com-Benutzernamen ein. Wir zählen die täglich gespielten Partien über die öffentliche API -- kein Login nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your Chess.com username. We'll count games played each day via the public API -- no login needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre ton pseudo Chess.com. Nous compterons les parties jouées chaque jour via l'API publique -- pas besoin de connexion."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess.com лақап атыңды енгіз. Күніне ойналған партияларды ашық API арқылы санаймыз -- кіру қажет емес."
          }
        }
      }
    },
