    "Соревнуйтесь, кто выполнит больше дел за время дуэли. Кто закрыл больше задач -- тот и победил. Себя обмануть легко, друга -- нет.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنافسا لمعرفة من ينجز أكثر المهام خلال المواجهة. من يُنهي أكثر المهام يفوز. خداع النفس سهل، لكن خداع صديقك لا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tretet an, wer während des Duells mehr Aufgaben erledigt. Wer die meisten abschließt, gewinnt. Sich selbst zu täuschen ist leicht -- einen Freund nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compete to see who finishes more tasks during the duel. Whoever closes out the most wins. It's easy to fool yourself -- not your friend."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affrontez-vous pour voir qui termine le plus de tâches pendant le duel. Celui qui en boucle le plus gagne. Se tromper soi-même est facile -- pas un ami."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дуэль кезінде кім көп тапсырма орындайтынын жарысыңдар. Кім ең көп аяқтаса, сол жеңеді. Өзіңді алдау оңай -- досыңды емес."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compite para ver quién termina más tareas durante el duelo. Quien cierre más gana. Es fácil engañarse a uno mismo, no a su amigo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決闘中にどちらがより多くのタスクを完了するかを競います。最も多く完封した人が勝ちです。友人ではなく、自分自身をだますのは簡単です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결투 중에 누가 더 많은 작업을 완료했는지 경쟁하세요. 가장 많이 마무리하는 사람이 승리합니다. 친구가 아니라 자신을 속이는 것은 쉽습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Competir para ver quem termina mais tarefas durante o duelo. Quem fechar mais ganha. É fácil enganar a si mesmo -- e não ao seu amigo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比拼看谁在决斗中完成更多任务。谁关闭最多，谁就获胜。欺骗自己很容易，而不是欺骗你的朋友。"
          }
        }
      }
    },
    "Соревнуйтесь, кто за это время выполнит больше дел.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنافسا لمعرفة من ينجز أكثر خلال هذا الوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tretet an, wer in dieser Zeit mehr schafft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compete to see who gets more done in that time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affrontez-vous pour voir qui accomplit le plus de choses pendant ce temps."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Осы уақытта кім көп іс орындайтынын жарысыңдар."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compite para ver quién hace más en ese tiempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その時間内に誰がより多くの成果を上げるかを競います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 시간에 누가 더 많은 일을 해내는지 경쟁해보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Competir para ver quem faz mais nesse período."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进行竞争，看看谁在这段时间内完成了更多的工作。"
          }
        }
      }
    },
