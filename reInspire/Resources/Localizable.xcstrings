    "Disconnect Telegram?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قطع الاتصال بتيليجرام؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram trennen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect Telegram?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter Telegram ?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram-ды ажырату керек пе?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить Telegram?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desconectar Telegram?"
          }
        },
        "ja": {
          "stringUnit": {
