            "state": "translated",
            "value": "过去 30 天"
          }
        }
      }
    },
    "За прошлую неделю ты занял %@ -- начислено %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الأسبوع الماضي حصلت على المركز %1$@ -- وتم إضافة %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Woche hast du Platz %1$@ belegt -- %2$@ gutgeschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "За прошлую неделю ты занял %1$@ -- начислено %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La semaine dernière, tu as terminé %1$@ -- %2$@ crédités."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Өткен аптада сен %1$@ орын алдың -- %2$@ есептелді."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la semana pasada pidió prestado %1$@ - %2$@ fue acreditado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 1 週間に %1$@ を借りました - %2$@ が入金されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 주 동안 %1$@을(를) 빌렸으며 %2$@이(가) 입금되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na semana passada você pegou emprestado %1$@ - creditou %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去一周您借用了 %1$@ - 记入 %2$@。"
          }
        }
      }
    },
    "Заведи ребёнку логин и PIN -- он войдёт на своём телефоне этими данными. Можно дать задание одному ребёнку (свайп влево по нему) или сразу всем.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ لطفلك اسم دخول ورمز PIN -- سيستخدمهما لتسجيل الدخول من هاتفه. يمكنك تعيين مهمة لطفل واحد (اسحب لليسار عليه) أو لجميعهم دفعة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte für dein Kind einen Login und eine PIN ein -- damit meldet es sich auf seinem Handy an. Du kannst eine Aufgabe einem Kind (nach links wischen) oder allen auf einmal zuweisen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a login and PIN for your kid -- they'll use it to sign in on their phone. You can assign a task to one kid (swipe left on them) or to all of them at once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un identifiant et un code PIN pour ton enfant -- il les utilisera pour se connecter sur son téléphone. Tu peux assigner une tâche à un enfant (glisse vers la gauche sur lui) ou à tous en même temps."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Балаңа логин мен PIN жаса -- ол өз телефонында осымен кіреді. Тапсырманы бір балаға (оны солға сырғыту) немесе бірден барлығына беруге болады."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure un inicio de sesión y un PIN para su hijo; los usará para iniciar sesión en su teléfono. Puedes asignar una tarea a un niño (deslízalo hacia la izquierda) o a todos a la vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子様のログインと PIN を設定します。お子様はそれを携帯電話でのサインインに使用します。タスクを 1 人の子供に割り当てることも (子供を左にスワイプする)、全員に一度に割り当てることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자녀의 로그인 및 PIN을 설정하세요. 자녀는 이를 사용하여 휴대폰에 로그인합니다. 한 명의 어린이에게 작업을 할당하거나(왼쪽으로 스와이프) 한 번에 모든 어린이에게 할당할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure um login e um PIN para seu filho -- eles os usarão para fazer login no telefone. Você pode atribuir uma tarefa a uma criança (deslize para a esquerda) ou a todas elas de uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为您的孩子设置登录名和 PIN 码 - 他们将使用它在手机上登录。您可以将一项任务分配给一个孩子（向左滑动）或同时分配给所有孩子。"
          }
        }
      }
    },
    "Заверши день с гордостью за себя.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ يومك فخورًا بنفسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende den Tag stolz auf dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the day proud of yourself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine la journée fier de toi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Күнді өзіңмен мақтанып аяқта."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina el día orgulloso de ti mismo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分に誇りを持って一日を終えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자랑스럽게 하루를 마무리하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine o dia orgulhoso de si mesmo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为自己感到骄傲结束这一天。"
          }
        }
      }
    },
    "Заверши настройку аккаунта": {
