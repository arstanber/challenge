    },
    "Введи свой ник на Chess.com. Мы будем считать сыгранные за день партии через публичный API -- авторизация не нужна.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم المستخدم الخاص بك على Chess.com. سنحسب المباريات التي تُلعب كل يوم عبر الواجهة البرمجية العامة -- لا حاجة لتسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinen Chess.com-Benutzernamen ein. Wir zählen die täglich gespielten Partien über die öffentliche API -- kein Login nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your Chess.com username. We'll count games played each day via the public API -- no login needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre ton pseudo Chess.com. Nous compterons les parties jouées chaque jour via l'API publique -- pas besoin de connexion."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess.com лақап атыңды енгіз. Күніне ойналған партияларды ашық API арқылы санаймыз -- кіру қажет емес."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca su nombre de usuario de Chess.com. Contaremos los juegos jugados cada día a través de la API pública; no es necesario iniciar sesión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess.com のユーザー名を入力します。パブリック API 経由で毎日プレイされたゲームをカウントします。ログインは必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chess.com 사용자 이름을 입력하세요. 공개 API를 통해 매일 플레이한 게임 수를 계산하므로 로그인이 필요하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite seu nome de usuário do Chess.com. Contaremos os jogos jogados todos os dias por meio da API pública -- sem necessidade de login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入您的 Chess.com 用户名。我们将通过公共 API 统计每天玩的游戏----无需登录。"
          }
        }
      }
    },
