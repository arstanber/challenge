    "Потрясите оба телефона рядом, чтобы присоединиться к дуэли друга.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هزّا الهاتفين معًا بالقرب من بعضهما للانضمام إلى تحدي صديقك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schüttelt beide Handys zusammen, um dem Duell deines Freundes beizutreten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake both phones close together to join your friend's duel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secouez les deux téléphones rapprochés pour rejoindre le duel de ton ami."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Достың дуэльіне қосылу үшін екі телефонды бірге шайқа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agita ambos teléfonos para unirte al duelo de tu amigo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の携帯電話を近づけてシェイクすると、友達の決闘に参加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구의 결투에 참여하려면 두 휴대폰을 서로 가깝게 흔드세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agite os dois telefones para se juntar ao duelo do seu amigo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将两部手机靠近摇动即可加入朋友的决斗。"
          }
        }
      }
    },
