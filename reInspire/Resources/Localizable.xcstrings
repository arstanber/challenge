    "Подключи источник данных, и прогресс по %@ %@%@ будет засчитываться сам -- без ручных отчётов.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط مصدر بيانات، وسيتم تسجيل تقدّمك في %1$@ %2$@%3$@ تلقائيًا -- بدون تقارير يدوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde eine Datenquelle, und dein Fortschritt bei %1$@ %2$@%3$@ wird automatisch gezählt -- ohne manuelle Berichte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Подключи источник данных, и прогресс по %1$@ %2$@%3$@ будет засчитываться сам -- без ручных отчётов."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte une source de données, et ta progression pour %1$@ %2$@%3$@ sera comptabilisée automatiquement -- sans rapports manuels."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерек көзін қос, сонда %1$@ %2$@%3$@ бойынша прогресс өздігінен есептеледі -- қолмен есеп берудің қажеті жоқ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte una fuente de datos y el progreso en %1$@ %2$@%3$@ se contará automáticamente, sin informes manuales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ ソースに接続すると、%1$@ %2$@%3$@ の進行状況が自動的にカウントされ、手動レポートは必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 소스를 연결하면 %1$@ %2$@%3$@의 진행 상황이 수동 보고 없이 자동으로 계산됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte uma fonte de dados e o progresso em %1$@ %2$@%3$@ será contado automaticamente - sem relatórios manuais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接数据源，%1$@ %2$@%3$@ 的进度将自动计数 - 无需手动报告。"
          }
        }
      }
    },
