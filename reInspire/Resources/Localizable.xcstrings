    "Объединяй привычки в последовательности и выполняй их без лишних пауз.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع العادات في تسلسلات وأنجزها من دون فواصل غير ضرورية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasse Gewohnheiten zu Abläufen zusammen und erledige sie ohne unnötige Pausen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group habits into sequences and complete them without unnecessary pauses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupe tes habitudes en séquences et enchaîne-les sans pauses inutiles."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттерді бірізді тізбектерге біріктіріп, артық үзіліссіз орында."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединяй привычки в последовательности и выполняй их без лишних пауз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa hábitos en secuencias y complétalas sin pausas innecesarias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣をシーケンスにグループ化し、不必要な中断をせずに完了させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관을 순서대로 그룹화하고 불필요한 일시 중지 없이 완료하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe hábitos em sequências e complete-os sem pausas desnecessárias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将习惯按顺序分组并完成它们，无需不必要的停顿。"
          }
        }
      }
    },
