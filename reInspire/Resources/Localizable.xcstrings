    "Введи код друга и получи 3 дня PRO.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز صديقك واحصل على 3 أيام من PRO."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Code eines Freundes ein und erhalte 3 Tage PRO."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a friend's code and get 3 days of PRO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre le code d'un ami et obtiens 3 jours de PRO."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Достың кодын енгізіп, 3 күн PRO ал."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa el código de un amigo y obtén 3 días de PRO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達のコードを入力すると、3 日間の PRO を入手できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구의 코드를 입력하고 3일간 PRO를 받으세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código de um amigo e ganhe 3 dias de PRO."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入朋友的代码并获得 3 天的 PRO。"
          }
        }
      }
    },
    "Введи код, который прислал друг": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز الذي أرسله صديقك"
          }
        },
        "de": {
          "stringUnit": {
