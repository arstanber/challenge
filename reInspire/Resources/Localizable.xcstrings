    "Мы напомним только, если привычка ещё не выполнена.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنذكّرك فقط إذا لم تكتمل العادة بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir erinnern dich nur, wenn die Gewohnheit noch nicht erledigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll only remind you if the habit isn't done yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On te le rappellera seulement si l'habitude n'est pas encore terminée."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдет әлі орындалмаса ғана еске саламыз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo te lo recordaremos si aún no has adquirido el hábito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "習慣がまだ完了していない場合にのみ通知されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 습관이 완료되지 않은 경우에만 알림을 보내드립니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só iremos lembrá-lo se o hábito ainda não tiver sido criado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当该习惯尚未养成时，我们才会提醒您。"
          }
        }
      }
    },
