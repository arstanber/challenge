    "Подключи источник данных, и прогресс по %@ %@%@ будет засчитываться сам -- без ручных отчётов.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط مصدر بيانات، وسيتم تسجيل تقدّمك في %1$@ %2$@%3$@ تلقائيًا -- بدون تقارير يدوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde eine Datenquelle, und dein Fortschritt bei %1$@ %2$@%3$@ wird automatisch gezählt -- ohne manuelle Berichte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Подключи источник данных, и прогресс по %1$@ %2$@%3$@ будет засчитываться сам -- без ручных отчётов."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte une source de données, et ta progression pour %1$@ %2$@%3$@ sera comptabilisée automatiquement -- sans rapports manuels."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дерек көзін қос, сонда %1$@ %2$@%3$@ бойынша прогресс өздігінен есептеледі -- қолмен есеп берудің қажеті жоқ."
          }
        }
      }
    },
